diff --git a/tabs.js b/tabs.js
new file mode 100644
index 0000000..ffb1bb6
--- /dev/null
+++ b/tabs.js
@@ -0,0 +1,56 @@
+// [mm-fridge patch] new file
+"use strict";
+
+const fs = require("fs");
+const path = require("path");
+
+// [mm-fridge patch] Tabs are renamed from the admin page. Tasks are stored per
+// tab name, so a rename would hide them. The last tab list is kept in
+// members.json; a name that changed in the same position (same number of
+// tabs) moves its tasks to the new name. Removed tabs keep their tasks in
+// tasks.json, so re-adding the same name brings them back.
+function renamesBetween(previous, current) {
+  if (!Array.isArray(previous) || !Array.isArray(current) || previous.length !== current.length) return [];
+  const out = [];
+  previous.forEach((oldName, i) => {
+    const newName = current[i];
+    if (oldName !== newName && !current.includes(oldName) && !previous.includes(newName)) out.push([oldName, newName]);
+  });
+  return out;
+}
+
+function applyRenames(dir, members) {
+  const membersFile = path.join(dir, "members.json");
+  const tasksFile = path.join(dir, "tasks.json");
+  let previous = null;
+  try {
+    previous = JSON.parse(fs.readFileSync(membersFile, "utf-8"));
+  } catch {
+    // first start with this patch: nothing to compare
+  }
+  const renames = renamesBetween(previous, members);
+  if (renames.length) {
+    try {
+      const tasks = JSON.parse(fs.readFileSync(tasksFile, "utf-8"));
+      for (const [oldName, newName] of renames) {
+        if (Array.isArray(tasks[oldName]) && !tasks[newName]) {
+          tasks[newName] = tasks[oldName];
+          delete tasks[oldName];
+          console.log("MMM-TodoList: tab renamed '" + oldName + "' -> '" + newName + "', tasks moved");
+        }
+      }
+      fs.writeFileSync(tasksFile + ".tmp", JSON.stringify(tasks, null, 2));
+      fs.renameSync(tasksFile + ".tmp", tasksFile);
+    } catch (err) {
+      if (err.code !== "ENOENT") console.error("MMM-TodoList: rename failed: " + err.message);
+    }
+  }
+  try {
+    fs.writeFileSync(membersFile + ".tmp", JSON.stringify(members));
+    fs.renameSync(membersFile + ".tmp", membersFile);
+  } catch (err) {
+    console.error("MMM-TodoList: could not save members.json: " + err.message);
+  }
+}
+
+module.exports = { renamesBetween, applyRenames };
