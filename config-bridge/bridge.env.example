# mm-configbridge settings. install.sh copies this to
# ~/.config/mm-configbridge/bridge.env (mode 600) and generates BRIDGE_TOKEN.
# Never commit the real file.

# Required. At least 24 characters. Paste it into the admin page once per device.
BRIDGE_TOKEN=

# Port on the Tailscale interface. MagicMirror itself stays on localhost:8080.
BRIDGE_PORT=8081

# "tailscale" = bind to this Pi's Tailscale IPv4 only (default, recommended).
# Never 0.0.0.0. An explicit IP is allowed, e.g. 127.0.0.1 for local tests.
BRIDGE_BIND=tailscale

# Optional: only these Tailscale users may connect (checked with `tailscale whois`).
# Comma separated login names. Empty = any device on your tailnet.
BRIDGE_ALLOWED_TAILSCALE_USERS=

# Optional second layer: HTTP basic auth on every request, including the page.
BRIDGE_BASIC_USER=
BRIDGE_BASIC_PASS=

# Local testing only: accept requests from 127.0.0.1 / ::1.
BRIDGE_ALLOW_LOOPBACK=0

# MagicMirror location and how to restart it.
MM_DIR=/home/REPLACE_USER/MagicMirror
MM_URL=http://localhost:8080
MM_RESTART_CMD=systemctl --user restart magicmirror.service
# Seconds to wait for MagicMirror to come back before restoring the backup.
MM_LIVE_TIMEOUT_S=180
