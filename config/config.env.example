# MagicMirror environment file. install.sh copies this to
# ~/MagicMirror/config/config.env (mode 600) only if that file does not exist.
#
# MagicMirror loads it into process.env at startup and substitutes "${NAME}"
# in config.js. It is never served over HTTP (js/server.js blocks it).
# Names starting with SECRET_ are redacted from the browser and only
# restored inside the owning module's node_helper.
#
# Quote values that contain # or spaces with single quotes.

# Required marker: lets config.js resolve bridge secrets on the server only.
SECRET_MM_FULL_PASS=1

# ---- Calendar feeds (Google Calendar > Settings > calendar > "Secret address in iCal format")
# Remove a line entirely if you do not use that feed. Add more from the admin page.
SECRET_CAL_FAMILY='https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics'
SECRET_CAL_ME='https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics'
# SECRET_CAL_PARTNER='https://...'
# SECRET_CAL_PARTNER_2='https://...'

# ---- Home location (globe home pin and default forecast). ALL OPTIONAL.
# Leave these out and the mirror finds home automatically: nearby Wi-Fi via the
# Google Geolocation API (enable it on the same Google key), else your internet
# connection (city level). You can also set or correct home in the admin page.
# HOME_ADDRESS='123 Example St, City, ST'
# HOME_LAT=40.7128
# HOME_LNG=-74.0060

# ---- Google key used ON THE PI (server side only, never sent to the screen)
# Enable these APIs on it in Google Cloud (APIs & Services), and restrict the
# key to them: Geocoding API (search, place names), Geolocation API (automatic
# home from nearby Wi-Fi), Weather API, Air Quality API, Time Zone API.
SECRET_GOOGLE_MAPS_KEY=REPLACE_ME

# ---- Google BROWSER key for the 3D Earth on the globe page (FEATURES.googleEarth)
# Not a secret: the screen's browser has to load it. Make a SECOND key and
# restrict it in Google Cloud > Credentials:
#   Application restrictions: Websites, add  http://localhost:8080/*
#   API restrictions: Maps JavaScript API and Map Tiles API only
# Leave it out to use the simple globe.
# GOOGLE_MAPS_BROWSER_KEY=REPLACE_ME

# ---- Guest Wi-Fi for the QR popup (tap the network icon, top right).
# Shown on screen by design. Any characters are fine. The admin page can override these.
GUEST_WIFI_SSID='Guest'
GUEST_WIFI_PASSWORD='change-me'
